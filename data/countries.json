def render_countries(
    lang: str,
    text: Dict[str, str],
):
    with st.expander(
        text["countries"],
        expanded=False,
    ):
        for item in COUNTRIES:
            flag = item.get(
                "flag",
                "🌍",
            )

            name = text_for(
                item.get("name", ""),
                lang,
            )

            muslims = text_for(
                item.get("muslims", ""),
                lang,
            )

            madhab = text_for(
                item.get("madhab", ""),
                lang,
            )

            diversity = item.get(
                "diverse",
                False,
            )

            if diversity:
                suffix = (
                    "(مع تنوع مذهبي)"
                    if lang == "ar"
                    else "(with religious diversity)"
                )

                madhab = f"{madhab} {suffix}"

            st.markdown(
                f"{flag} **{name}** — "
                f"{muslims} — {madhab}"
            )
